# omni-homevlog configuration.
# Copy to `.env` and fill in. NEVER commit `.env` or any credential file.

# ─────────────────────────────────────────────────────────────────────────────
# Provider selection
# ─────────────────────────────────────────────────────────────────────────────
# vertex      = Google Cloud Gemini Enterprise Agent Platform (ADC auth)  [verified]
# gemini_api  = Gemini Developer API (API key auth)                       [unverified]
OMNI_PROVIDER=vertex

# ─────────────────────────────────────────────────────────────────────────────
# Vertex / Agent Platform
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
OMNI_VERTEX_MODEL=gemini-omni-1.1-flash-preview
# Older fallback, 720p-only. Only used if you explicitly select it.
# OMNI_VERTEX_MODEL=gemini-omni-flash-preview

# Optional GCS output prefix. Must be a bucket you are approved to write to.
# `delivery: "uri"` is only sent when this is set (the API rejects delivery=uri without gcs_uri).
# OMNI_OUTPUT_GCS_URI=gs://APPROVED_BUCKET/omni-output/

# Prefer GCS delivery over inline base64 whenever a GCS prefix is configured.
OMNI_PREFER_GCS_DELIVERY=true

# ─────────────────────────────────────────────────────────────────────────────
# Gemini Developer API (only if OMNI_PROVIDER=gemini_api)
# ─────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=REPLACE_ME
OMNI_GEMINI_MODEL=gemini-omni-1.1-flash

# ─────────────────────────────────────────────────────────────────────────────
# Text/vision models used for planning and review.
# These are NOT the Omni video model: Omni has no system-instruction and no
# structured-output support, so planning/critique are separate models.
# ─────────────────────────────────────────────────────────────────────────────
DIRECTOR_MODEL=gemini-3.8-flash
CRITIC_MODEL=gemini-3.8-flash
DIRECTOR_LOCATION=global
CRITIC_LOCATION=global

# ─────────────────────────────────────────────────────────────────────────────
# Storage
# ─────────────────────────────────────────────────────────────────────────────
OMNI_DATA_DIR=./.omni-vlog
# Escape hatch for local dev when ffmpeg is absent.
OMNI_FFMPEG_BIN=ffmpeg
OMNI_FFPROBE_BIN=ffprobe

# ────────────────────────────────────────────────────────────────────────────
# Cost control
# ─────────────────────────────────────────────────────────────────────────────
OMNI_MAX_TOTAL_CALLS=8
OMNI_MAX_ESTIMATED_COST_USD=
OMNI_PRICING_FILE=pricing.yaml

# ────────────────────────────────────────────────────────────────────────────
# Safety switches
# ─────────────────────────────────────────────────────────────────────────────
# Live video tests are opt-in and cost money.
RUN_LIVE_VIDEO_TESTS=0
# Emit redacted raw provider payloads into the job's debug/ directory.
OMNI_KEEP_RAW_RESPONSES=true
OMNI_LOG_LEVEL=INFO